@baseUrl = http://localhost:3000/api/v1
@correlationId = demo-routefast-phase2

### Gateway health
GET {{baseUrl}}/health
x-correlation-id: {{correlationId}}

### Create an available driver
POST {{baseUrl}}/drivers
Content-Type: application/json
x-correlation-id: {{correlationId}}

{
  "displayName": "Driver One",
  "capacity": 1
}

### List drivers
GET {{baseUrl}}/drivers
x-correlation-id: {{correlationId}}

### Create order - asynchronously triggers dispatch
POST {{baseUrl}}/orders
Content-Type: application/json
x-correlation-id: {{correlationId}}

{
  "customerId": "CUS-1001",
  "priority": "EXPRESS",
  "pickup": {
    "label": "Warehouse",
    "address": "North Ave 10",
    "latitude": -0.16,
    "longitude": -78.47
  },
  "dropoff": {
    "label": "Customer",
    "address": "South Ave 20",
    "latitude": -0.19,
    "longitude": -78.49
  }
}

### List orders - observe PENDING -> DISPATCHING -> ASSIGNED
GET {{baseUrl}}/orders
x-correlation-id: {{correlationId}}

### List dispatch workflows
GET {{baseUrl}}/dispatches
x-correlation-id: {{correlationId}}
