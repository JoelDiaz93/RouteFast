NODE_ENV=development

API_GATEWAY_PORT=3000
ORDER_SERVICE_PORT=3001
DRIVER_SERVICE_PORT=3002
DISPATCH_SERVICE_PORT=3003
TRACKING_SERVICE_PORT=3004

ORDER_SERVICE_URL=http://localhost:3001
DRIVER_SERVICE_URL=http://localhost:3002
DISPATCH_SERVICE_URL=http://localhost:3003
TRACKING_SERVICE_URL=http://localhost:3004

ORDER_DB_HOST=localhost
ORDER_DB_PORT=55432
ORDER_DB_NAME=routefast_orders
ORDER_DB_USER=routefast
ORDER_DB_PASSWORD=routefast
ORDER_DB_SYNC=true
ORDER_DB_SSL=false

DRIVER_DB_HOST=localhost
DRIVER_DB_PORT=55433
DRIVER_DB_NAME=routefast_drivers
DRIVER_DB_USER=routefast
DRIVER_DB_PASSWORD=routefast
DRIVER_DB_SYNC=true
DRIVER_DB_SSL=false

DISPATCH_DB_HOST=localhost
DISPATCH_DB_PORT=55434
DISPATCH_DB_NAME=routefast_dispatch
DISPATCH_DB_USER=routefast
DISPATCH_DB_PASSWORD=routefast
DISPATCH_DB_SYNC=true
DISPATCH_DB_SSL=false

RABBITMQ_URL=amqp://routefast:routefast@localhost:5672
ORDER_EVENTS_QUEUE=routefast.order.events
DRIVER_EVENTS_QUEUE=routefast.driver.events
DISPATCH_EVENTS_QUEUE=routefast.dispatch.events

# Phase 3 reliability
OUTBOX_POLL_INTERVAL_MS=500
OUTBOX_BATCH_SIZE=25
RMQ_MAX_RETRIES=3
RMQ_RETRY_DELAY_MS=3000
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_TLS=false
DISPATCH_ASSIGNMENT_TIMEOUT_MS=30000

# Phase 4 geospatial & real-time
TRACKING_DB_HOST=localhost
TRACKING_DB_PORT=55435
TRACKING_DB_NAME=routefast_tracking
TRACKING_DB_USER=routefast
TRACKING_DB_SSL=false
TRACKING_DB_PASSWORD=routefast
TRACKING_GEO_KEY=routefast:tracking:drivers
TRACKING_META_PREFIX=routefast:tracking:driver-meta
TRACKING_LOCATION_TTL_SECONDS=120
TRACKING_PERSISTENCE_QUEUE=routefast.tracking.persistence
TRACKING_HISTORY_LIMIT=100
DISPATCH_CANDIDATE_LIMIT=20
DISPATCH_SEARCH_RADIUS_KM=8
DISPATCH_LOCATION_MAX_AGE_SECONDS=90
DISPATCH_DRIVER_WEIGHT_DISTANCE=0.55
DISPATCH_DRIVER_WEIGHT_CAPACITY=0.20
DISPATCH_DRIVER_WEIGHT_LOAD=0.15
DISPATCH_DRIVER_WEIGHT_FRESHNESS=0.10
ETA_AVERAGE_SPEED_KPH=28
ETA_ROAD_FACTOR=1.25

# Phase 5 observability
OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=http://localhost:4318/v1/traces
OTEL_SERVICE_NAME=routefast-local
OTEL_TRACES_SAMPLER=parentbased_always_on

# Phase 6 performance & resilience hardening
DEPENDENCY_TIMEOUT_MS=1500
CIRCUIT_BREAKER_FAILURE_THRESHOLD=5
CIRCUIT_BREAKER_RESET_TIMEOUT_MS=10000

# Successful HTTP access-log sampling. 4xx/5xx are always logged.
HTTP_ACCESS_LOG_SAMPLE_RATE=1
