NODE_ENV=development

API_GATEWAY_PORT=3000
ORDER_SERVICE_PORT=3001
DRIVER_SERVICE_PORT=3002
DISPATCH_SERVICE_PORT=3003

ORDER_SERVICE_URL=http://localhost:3001
DRIVER_SERVICE_URL=http://localhost:3002
DISPATCH_SERVICE_URL=http://localhost:3003

ORDER_DB_HOST=localhost
ORDER_DB_PORT=55432
ORDER_DB_NAME=routefast_orders
ORDER_DB_USER=routefast
ORDER_DB_PASSWORD=routefast
ORDER_DB_SYNC=true

DRIVER_DB_HOST=localhost
DRIVER_DB_PORT=55433
DRIVER_DB_NAME=routefast_drivers
DRIVER_DB_USER=routefast
DRIVER_DB_PASSWORD=routefast
DRIVER_DB_SYNC=true

DISPATCH_DB_HOST=localhost
DISPATCH_DB_PORT=55434
DISPATCH_DB_NAME=routefast_dispatch
DISPATCH_DB_USER=routefast
DISPATCH_DB_PASSWORD=routefast
DISPATCH_DB_SYNC=true

RABBITMQ_URL=amqp://routefast:routefast@localhost:5672
ORDER_EVENTS_QUEUE=routefast.order.events
DRIVER_EVENTS_QUEUE=routefast.driver.events
DISPATCH_EVENTS_QUEUE=routefast.dispatch.events
