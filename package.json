{
  "name": "routefast",
  "version": "0.7.6",
  "private": true,
  "description": "Distributed Last-Mile Logistics & Delivery Orchestration Platform",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "nest build api-gateway && nest build order-service && nest build driver-service && nest build dispatch-service && nest build tracking-service && node scripts/verify-dist.mjs",
    "start:gateway": "node dist/apps/api-gateway/main.js",
    "start:order": "node dist/apps/order-service/main.js",
    "start:gateway:prod": "npm run start:gateway",
    "start:order:prod": "npm run start:order",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "jest --runInBand",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "start:driver": "node dist/apps/driver-service/main.js",
    "start:dispatch": "node dist/apps/dispatch-service/main.js",
    "start:driver:prod": "npm run start:driver",
    "start:dispatch:prod": "npm run start:dispatch",
    "start:tracking": "node dist/apps/tracking-service/main.js",
    "start:tracking:prod": "npm run start:tracking",
    "demo:tracking": "node scripts/tracking-demo.mjs",
    "start:all": "npm run runtime:preflight && npm run build && npm run start:all:unsafe",
    "observability:up": "docker compose --profile observability up -d",
    "observability:down": "docker compose --profile observability down",
    "k8s:validate": "kubectl kustomize k8s/base > /dev/null",
    "load:smoke": "node scripts/load-preflight.mjs && docker compose --profile performance run --rm k6 run /scripts/smoke.js",
    "load:mixed": "node scripts/load-preflight.mjs && docker compose --profile performance run --rm k6 run /scripts/mixed-workload.js",
    "load:idempotency": "node scripts/load-preflight.mjs && docker compose --profile performance run --rm k6 run /scripts/idempotency.js",
    "profile:dispatch": "node scripts/profile-service.mjs dispatch-service",
    "profile:tracking": "node scripts/profile-service.mjs tracking-service",
    "k8s:performance:validate": "kubectl kustomize k8s/performance > /dev/null",
    "load:k6:version": "docker compose --profile performance run --rm k6 version",
    "load:smoke:local": "k6 run performance/k6/smoke.js",
    "load:idempotency:local": "k6 run performance/k6/idempotency.js",
    "load:mixed:local": "k6 run performance/k6/mixed-workload.js",
    "load:preflight": "node scripts/load-preflight.mjs",
    "dev:stack": "docker compose --profile observability up -d && npm run start:all",
    "dev:gateway": "nest start api-gateway --watch",
    "dev:order": "nest start order-service --watch",
    "dev:driver": "nest start driver-service --watch",
    "dev:dispatch": "nest start dispatch-service --watch",
    "dev:tracking": "nest start tracking-service --watch",
    "start:all:no-build": "npm run runtime:preflight && npm run start:all:unsafe",
    "verify:dist": "node scripts/verify-dist.mjs",
    "security:audit": "npm audit --omit=dev --audit-level=high",
    "security:gate": "npm run typecheck && npm test && npm run build && npm run security:audit",
    "runtime:preflight": "node scripts/runtime-port-preflight.mjs",
    "start:all:unsafe": "concurrently -k -n gateway,order,driver,dispatch,tracking \"npm run start:gateway\" \"npm run start:order\" \"npm run start:driver\" \"npm run start:dispatch\" \"npm run start:tracking\"",
    "load:stress": "node scripts/load-preflight.mjs && node scripts/run-stress.mjs",
    "load:stress:local": "k6 run --summary-export=performance/results/stress-latest.json performance/k6/stress.js && npm run benchmark:report",
    "benchmark:report": "node scripts/render-k6-summary.mjs performance/results/stress-latest.json performance/results/STRESS_LATEST.md",
    "showcase:check": "node scripts/showcase-check.mjs",
    "start:all:benchmark": "node scripts/start-benchmark.mjs",
    "ops:dev": "vite apps/ops-console --config apps/ops-console/vite.config.ts",
    "ops:typecheck": "tsc -p apps/ops-console/tsconfig.json",
    "ops:build": "vite build apps/ops-console --config apps/ops-console/vite.config.ts",
    "ops:preview": "vite preview apps/ops-console --config apps/ops-console/vite.config.ts",
    "validate:full": "npm run typecheck && npm test && npm run build && npm run ops:typecheck && npm run ops:build && npm run security:audit && npm run showcase:check"
  },
  "dependencies": {
    "@nestjs/axios": "^12.0.0",
    "@nestjs/common": "^12.0.1",
    "@nestjs/config": "^12.0.0",
    "@nestjs/core": "^12.0.1",
    "@nestjs/platform-express": "^12.0.1",
    "@nestjs/typeorm": "^12.0.0",
    "axios": "^1.11.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.2",
    "pg": "^8.16.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "typeorm": "^0.3.26",
    "@nestjs/cqrs": "^12.0.0",
    "@nestjs/microservices": "^12.0.1",
    "amqp-connection-manager": "^4.1.14",
    "amqplib": "^0.10.8",
    "bullmq": "^5.58.5",
    "ioredis": "^5.7.0",
    "@nestjs/websockets": "^12.0.1",
    "@nestjs/platform-socket.io": "^12.0.1",
    "socket.io": "^4.8.1",
    "@opentelemetry/api": "1.9.1",
    "@opentelemetry/auto-instrumentations-node": "0.79.0",
    "@opentelemetry/exporter-trace-otlp-http": "0.221.0",
    "@opentelemetry/sdk-node": "0.221.0",
    "prom-client": "15.1.3",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "leaflet": "^1.9.4"
  },
  "devDependencies": {
    "@nestjs/cli": "^12.0.0",
    "@nestjs/testing": "^12.0.1",
    "@types/jest": "^29.5.14",
    "@types/node": "^24.3.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.2.5",
    "ts-node": "^10.9.2",
    "typescript": "^5.8.3",
    "@types/express": "^5.0.3",
    "@nestjs/schematics": "^12.0.0",
    "@types/amqplib": "^0.10.7",
    "socket.io-client": "^4.8.1",
    "concurrently": "^9.1.0",
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "@vitejs/plugin-react": "^5.0.2",
    "vite": "^7.1.3",
    "@types/leaflet": "^1.9.20"
  }
}
