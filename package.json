{
  "name": "routefast",
  "version": "0.3.0",
  "private": true,
  "description": "Distributed Last-Mile Logistics & Delivery Orchestration Platform",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "nest build api-gateway && nest build order-service && nest build driver-service && nest build dispatch-service",
    "start:gateway": "nest start api-gateway --watch",
    "start:order": "nest start order-service --watch",
    "start:gateway:prod": "node dist/apps/api-gateway/main.js",
    "start:order:prod": "node dist/apps/order-service/main.js",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "jest --runInBand",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "start:driver": "nest start driver-service --watch",
    "start:dispatch": "nest start dispatch-service --watch",
    "start:driver:prod": "node dist/apps/driver-service/main.js",
    "start:dispatch:prod": "node dist/apps/dispatch-service/main.js"
  },
  "dependencies": {
    "@nestjs/axios": "^4.0.1",
    "@nestjs/common": "^11.1.6",
    "@nestjs/config": "^4.0.2",
    "@nestjs/core": "^11.1.6",
    "@nestjs/platform-express": "^11.1.6",
    "@nestjs/typeorm": "^11.0.0",
    "axios": "^1.11.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.2",
    "pg": "^8.16.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "typeorm": "^0.3.26",
    "@nestjs/cqrs": "^11.0.3",
    "@nestjs/microservices": "^11.1.6",
    "amqp-connection-manager": "^4.1.14",
    "amqplib": "^0.10.8",
    "bullmq": "^5.58.5",
    "ioredis": "^5.7.0"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.10",
    "@nestjs/testing": "^11.1.6",
    "@types/jest": "^29.5.14",
    "@types/node": "^24.3.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.2.5",
    "ts-node": "^10.9.2",
    "typescript": "^5.8.3",
    "@types/express": "^5.0.3",
    "@nestjs/schematics": "^11.0.7",
    "@types/amqplib": "^0.10.7"
  }
}
